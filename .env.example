# Server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
OPEN_BROWSER=true
LOG_LEVEL=INFO

# API keys (optional; users can also enter keys in the browser)
GOOGLE_API_KEY=
AMAP_API_KEY=

# Comma-separated origins. Use the deployed frontend origin in production.
# Example: https://your-domain.example
CORS_ORIGINS=*
